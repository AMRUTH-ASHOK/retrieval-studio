# Development Configuration
# Note: This app requires actual Databricks credentials to work fully

# Databricks Configuration (required for full functionality)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_CLIENT_ID=your-service-principal-client-id
DATABRICKS_CLIENT_SECRET=your-service-principal-secret
DATABRICKS_HTTP_PATH=/sql/1.0/endpoints/your-endpoint-id

# Catalog and Schema
CATALOG=retrievalstudio
SCHEMA=retrieval_studio

# API Configuration
DEBUG=true
USE_POSTGRES=false
